# ===== 运行环境 =====
APP_ENV=dev
LOG_LEVEL=INFO

# ===== 数据库 =====
# 本地 Docker Compose 的 PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=calorie_coach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 异步/同步连接串（SQLAlchemy）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/calorie_coach

# ===== 向量库（PostgreSQL + pgvector，同库不同表）=====
VECTOR_DIM=1024

# ===== 知识切片灌入（首次需要，之后走缓存）=====
# 用法：.venv/Scripts/python.exe -m app.retrieval.index_chunks

# ===== 大模型（DashScope OpenAI 兼容接口）=====
DASHSCOPE_API_KEY=sk-请填入你的APIKey
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
EMBED_MODEL=text-embedding-v4

# ===== 单用户档案（演示模式）=====
PROFILE_GENDER=male
PROFILE_AGE=28
PROFILE_HEIGHT_CM=175
PROFILE_WEIGHT_KG=78
PROFILE_ACTIVITY_LEVEL=1.375
PROFILE_GOAL=lose

# ===== 安全边界（服务端硬校验）=====
# 每日热量摄入下限：男1500 / 女1200
MIN_INTAKE_KCAL_MALE=1500
MIN_INTAKE_KCAL_FEMALE=1200
# 目标热量不得低于 BMR 的比例
MIN_TARGET_BMR_RATIO=1.0